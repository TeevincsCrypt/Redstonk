# RedStonk environment. Copy to .env.local and fill in. Every value is optional for `npm run dev`:
# with nothing set, the app boots on devnet with the labeled fixture closes and no launches.

# ---------------------------------------------------------------------------------------------
# Cluster and RPC

# Where launches are written and coin tickets are read: devnet (default) or mainnet-beta.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC for that cluster. Required for mainnet-beta, which never falls back. On devnet, empty falls
# back to the public endpoint https://api.devnet.solana.com (in dev and in production builds).
NEXT_PUBLIC_RPC_URL=

# ---------------------------------------------------------------------------------------------
# Raydium LaunchLab platform

# Your LaunchLab PlatformConfig address on the cluster above. Create one with
# `npm run platform:create -- --keypair <admin.json>` (0.5% platform + 0.5% creator, LP burned).
# Empty = the Sign button stays disabled and the UI says "platform not configured".
# RedStonk never falls back to Raydium's default platform.
NEXT_PUBLIC_PLATFORM_ID=

# ---------------------------------------------------------------------------------------------
# Supported quotes. One mint + LaunchLab GlobalConfig pair per ticker.
#
# MINT    the xStock mint on the cluster above
# CONFIG  a LaunchLab GlobalConfig whose quote mint (mintB) is that mint
# RAISE   optional graduation target in whole quote tokens. Used only when Raydium publishes no
#         default curve for CONFIG. Empty + no published default = that name cannot launch.
#
# An empty MINT or CONFIG means the name can still show on the board but can never launch.
# `npm run scan:configs` lists candidates read from mainnet; verify every mint against the
# issuer's published list before using it. On devnet, use devnet stand-in mints and configs.

NEXT_PUBLIC_NVDAX_MINT=
NEXT_PUBLIC_NVDAX_CONFIG=
NEXT_PUBLIC_NVDAX_RAISE=

NEXT_PUBLIC_AAPLX_MINT=
NEXT_PUBLIC_AAPLX_CONFIG=
NEXT_PUBLIC_AAPLX_RAISE=

NEXT_PUBLIC_TSLAX_MINT=
NEXT_PUBLIC_TSLAX_CONFIG=
NEXT_PUBLIC_TSLAX_RAISE=

NEXT_PUBLIC_MSFTX_MINT=
NEXT_PUBLIC_MSFTX_CONFIG=
NEXT_PUBLIC_MSFTX_RAISE=

NEXT_PUBLIC_AMZNX_MINT=
NEXT_PUBLIC_AMZNX_CONFIG=
NEXT_PUBLIC_AMZNX_RAISE=

NEXT_PUBLIC_GOOGLX_MINT=
NEXT_PUBLIC_GOOGLX_CONFIG=
NEXT_PUBLIC_GOOGLX_RAISE=

NEXT_PUBLIC_METAX_MINT=
NEXT_PUBLIC_METAX_CONFIG=
NEXT_PUBLIC_METAX_RAISE=

NEXT_PUBLIC_SPYX_MINT=
NEXT_PUBLIC_SPYX_CONFIG=
NEXT_PUBLIC_SPYX_RAISE=

NEXT_PUBLIC_QQQX_MINT=
NEXT_PUBLIC_QQQX_CONFIG=
NEXT_PUBLIC_QQQX_RAISE=

# ---------------------------------------------------------------------------------------------
# Server-only

# Solana secret key (base58, or a solana-keygen JSON byte array) that pays for Irys storage of
# token metadata and images. It never touches user funds. Unset = dev-only inline data URI
# metadata, and mainnet launch is disabled.
IRYS_PRIVATE_KEY=

# Daily closes endpoint, as a URL template with {symbol} (NVDA) or {symbol_lower} (nvda).
# The response must be CSV with Date and Close columns (Volume optional), or JSON rows of
# {date, close, volume}. Example (Stooq daily CSV):
#   STOCK_DATA_URL=https://stooq.com/q/d/l/?s={symbol_lower}.us&i=d
# Unset = the labeled fixture in data/fixture-closes.json (never used on mainnet-beta).
# If set and a fetch fails, that name has no close and no print is named. Prices are never invented.
STOCK_DATA_URL=

# Dev only: which fixture to serve when STOCK_DATA_URL is unset. "green" serves a green-only
# board (no red print). Anything else serves the default fixture with one red winner.
PRINT_FIXTURE=
